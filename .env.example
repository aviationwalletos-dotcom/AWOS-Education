# 이 파일을 .env.local 로 복사해서 쓴다. .env.local 은 저장소에 올리지 않는다.

# AWOS 와 같은 Supabase 프로젝트 값을 넣으면 로그인 상태를 같이 쓴다(같은 주소 아래에 붙었을 때).
# 비워 두면 연동 없이 화면만 뜬다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AWOS 앱 주소. 머리의 [AWOS] 버튼이 가는 곳. 비우면 https://aviationwallet.com
VITE_AWOS_ORIGIN=

# 붙는 주소를 바꿀 때만. 비우면 module.config.json 의 basePath
VITE_BASE_PATH=
